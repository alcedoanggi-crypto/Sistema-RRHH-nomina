# Copia este archivo a .env y ajusta los valores
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rrhh_nomina

# Carpeta de subida de documentos (relativa a app/static)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10
